% =========================================================================
% FUNÇÕES DO ELEMENTO Q4
% =========================================================================

function [N, B, DJ] = Q4(r, s, coord)
    % Funções de forma para elemento Q4
    N = 0.25 * [(1-r)*(1-s), (1+r)*(1-s), (1+r)*(1+s), (1-r)*(1+s)];

    % Derivadas em relação às coordenadas naturais (r, s)
    dNdr = 0.25 * [-(1-s),  (1-s), (1+s), -(1+s)];
    dNds = 0.25 * [-(1-r), -(1+r), (1+r),  (1-r)];
    DiffN = [dNdr; dNds];

    % Jacobiana
    J = DiffN * coord;
    DJ = det(J);
    invJ = inv(J);

    % Matriz B
    B = invJ * DiffN;
end

% =========================================================================
% FUNÇÕES DO ELEMENTO T3
% =========================================================================

function [N, B, DJ] = T3(r, s, coord)

    % Funções de forma para elemento T3
    N = [1-r-s, r, s];

    % Derivadas em relação a r e s
    DiffN = [-1, 1, 0;
             -1, 0, 1];

    % Jacobiana
    J = DiffN * coord;
    DJ = det(J);

    % Matriz B
    B = inv(J) * DiffN;
end

% =========================================================================
% FUNÇÕES DO ELEMENTO Q8
% =========================================================================

function [N, B, DJ] = Q8(r, s, coord)

    % Funções de forma Serendipidade (8 nós)
    N = zeros(1, 8);
    % Nós dos cantos
    N(1) = 0.25*(1-r)*(1-s)*(-r-s-1);
    N(2) = 0.25*(1+r)*(1-s)*(r-s-1);
    N(3) = 0.25*(1+r)*(1+s)*(r+s-1);
    N(4) = 0.25*(1-r)*(1+s)*(-r+s-1);
    % Nós dos meios das arestas
    N(5) = 0.5*(1-r^2)*(1-s);
    N(6) = 0.5*(1+r)*(1-s^2);
    N(7) = 0.5*(1-r^2)*(1+s);
    N(8) = 0.5*(1-r)*(1-s^2);

    % Derivadas das funções de forma em r e s
    t1r = (1/4)*s+(1/2)*r*(1+s)+(1/4)*s^2;
    t2r = -(1/4)*s+(1/2)*r*(1+s)-(1/4)*s^2;
    t3r = (1/4)*s-(1/4)*s^2+(1/2)*r*(1-s);
    t4r = -(1/4)*s+(1/2)*r*(1-s)+(1/4)*s^2;
    t5r = -r*(1+s);
    t6r = (1/2)*s^2-1/2;
    t7r = -r*(1-s);
    t8r = -(1/2)*s^2+1/2;

    t1s = (1/4)*r+(1/4)*r^2+(1/2)*s*(1+r);
    t2s = -(1/4)*r+(1/4)*r^2+(1/2)*s*(1-r);
    t3s = (1/4)*r+(1/2)*s*(1-r)-(1/4)*r^2;
    t4s = -(1/4)*r-(1/4)*r^2+(1/2)*s*(1+r);
    t5s = -(1/2)*r^2+1/2;
    t6s = -s*(1-r);
    t7s = (1/2)*r^2-1/2;
    t8s = -s*(1+r);

    % Derivadas em relação a r e s
    DiffN = [t1r t2r t3r t4r t5r t6r t7r t8r;
             t1s t2s t3s t4s t5s t6s t7s t8s];

    % Jacobiana
    J = DiffN * coord;
    DJ = det(J);

    % Matriz B (2x8)
    B = inv(J) * DiffN;
end

% =========================================================================
% FUNÇÕES DO ELEMENTO T6
% =========================================================================

function [N, B, DJ] = T6(r, s, coord)

    % Funções de forma quadráticas
    L3 = 1 - r - s;
    N = [(2*L3-1)*L3, (2*r-1)*r, (2*s-1)*s, 4*r*L3, 4*r*s, 4*s*L3];

    % Derivadas em relação a r e s
    t1r = -3+4*r+4*s; t2r = -1+4*r; t3r = 0;   t4r = 4-8*r-4*s; t5r = 4*s; t6r = -4*s;
    t1s = -3+4*r+4*s; t2s = 0;      t3s = -1+4*s; t4s = -4*r;      t5s = 4*r; t6s = 4-4*r-8*s;

    DiffN = [t1r t2r t3r t4r t5r t6r;
             t1s t2s t3s t4s t5s t6s];

    % Jacobiana
    J = DiffN * coord;
    DJ = det(J);

    % Matriz B (2x6)
    B = inv(J) * DiffN;
end


function [Ke, fe] = Kf(ele, elcoor, ijk, k_mat, f_vol)

    nodes = ijk(ele, :);
    coord = elcoor(nodes, :);
    nne = length(nodes);

    Ke = zeros(nne, nne);
    fe = zeros(nne, 1);


    switch nne

      % Q4
      case 4

        g = 0.577350269189626;
        gpts = [-g, -g; g, -g; g, g; -g, g];
        weights = [1, 1, 1, 1];

        for p = 1:4
            r = gpts(p, 1);
            s = gpts(p, 2);
            [N, B, DJ] = Q4(r, s, coord);

            Ke = Ke + (k_mat * (B' * B)) * DJ * weights(p);
            fe = fe + (N' * f_vol) * DJ * weights(p);

        end

      % T3
      case 3

        % Integração de 1 ponto
        [N, B, DJ] = T3(1/3, 1/3, coord);
        area = 0.5 * DJ;
        Ke = (k_mat * (B' * B)) * area;
        fe = (N' * f_vol) * area;

      % Q8
      case 8

        gpts = [-0.7745966692, 0, 0.7745966692];
        weights = [5/9, 8/9, 5/9];
        for q = 1:3
            for p = 1:3
                r = gpts(p);
                s = gpts(q);
                W = weights(p) * weights(q);
                [N, B, DJ] = Q8(r, s, coord);

                Ke = Ke + (k_mat * (B' * B)) * DJ * W;
                fe = fe + (N' * f_vol) * DJ * W;
            end
        end

      % T6
      case 6

        gpts = [1/6 2/3 1/6; 1/6 1/6 2/3];
        weights = [1/6 1/6 1/6];
        for p = 1:3
            r = gpts(1, p);
            s = gpts(2, p);
            [N, B, DJ] = T6(r, s, coord);

            Ke = Ke + (k_mat * (B' * B)) * DJ * weights(p);
            fe = fe + (N' * f_vol) * DJ * weights(p);
        end

      otherwise
            error('nne não suportado.');

      endswitch

end

